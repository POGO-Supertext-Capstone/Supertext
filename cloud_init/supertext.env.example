# supertext hotspot configuration
# copy file to SD card's boot partition
# rename copy to supertext.env 
# change POGO_AP_PASSWORD and do not commit supertex.env
POGO_APP_USER=

POGO_AP_PASSWORD=CHANGE_THIS_TO_A_UNIQUE_WIFI_PASSWORD

POGO_SSID=POGOSupertext

POGO_AP_CONNECTION=POGOSupertext

POGO_WIFI_IF=wlan0